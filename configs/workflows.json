{
  "workflows": [
    {
      "id": "linear-5",
      "description": "Five-task linear continuum pipeline.",
      "tasks": [
        {
          "id": "acquire",
          "service_time_s": 0.25,
          "output_size_factor": 1.0
        },
        {
          "id": "preprocess",
          "service_time_s": 0.9,
          "output_size_factor": 0.7
        },
        {
          "id": "extract",
          "service_time_s": 1.5,
          "output_size_factor": 0.4
        },
        {
          "id": "analyse",
          "service_time_s": 4.0,
          "output_size_factor": 0.15
        },
        {
          "id": "archive",
          "service_time_s": 0.3,
          "output_size_factor": 1.0
        }
      ],
      "edges": [
        {
          "id": "raw-data",
          "from": "acquire",
          "to": "preprocess",
          "policy_group": "protected",
          "risk_tags": [
            "sensitive",
            "critical",
            "resilient",
            "bulk"
          ],
          "nfr_families": [
            "compression",
            "confidentiality",
            "reliability",
            "integrity"
          ]
        },
        {
          "id": "curated-data",
          "from": "preprocess",
          "to": "extract",
          "policy_group": "protected",
          "risk_tags": [
            "sensitive",
            "bulk"
          ],
          "nfr_families": [
            "compression",
            "confidentiality",
            "integrity"
          ]
        },
        {
          "id": "features",
          "from": "extract",
          "to": "analyse",
          "policy_group": "protected",
          "risk_tags": [
            "sensitive",
            "bulk"
          ],
          "nfr_families": [
            "compression",
            "confidentiality",
            "integrity"
          ]
        },
        {
          "id": "analysis-result",
          "from": "analyse",
          "to": "archive",
          "policy_group": "result",
          "risk_tags": [
            "critical",
            "authentic",
            "resilient"
          ],
          "nfr_families": [
            "reliability",
            "integrity"
          ]
        }
      ],
      "plans": [
        {
          "id": "continuum-balanced",
          "placement": {
            "acquire": "Edge_p",
            "preprocess": "Fog1_de",
            "extract": "Fog2_dd",
            "analyse": "Cloud_c3_1",
            "archive": "Fog1_de"
          }
        },
        {
          "id": "fog-heavy",
          "placement": {
            "acquire": "Edge_p",
            "preprocess": "Fog1_de",
            "extract": "Fog2_dd",
            "analyse": "Fog2_dd",
            "archive": "Fog1_de"
          }
        },
        {
          "id": "hpc-heavy",
          "placement": {
            "acquire": "Edge_p",
            "preprocess": "Fog1_de",
            "extract": "Cloud_c3_1",
            "analyse": "Cloud_c3_2",
            "archive": "Cloud_c3_3"
          }
        }
      ]
    },
